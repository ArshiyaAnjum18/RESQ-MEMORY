# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# HINDSIGHT_API_KEY: Optional/Production API key for Hindsight persistent agent memory bank.
# If omitted, RESQ runs with an explicit, transparently labeled demo fallback memory bank.
HINDSIGHT_API_KEY=""

# HINDSIGHT_BASE_URL: Base URL for Hindsight REST endpoints (default: https://api.hindsight.vectorize.io)
HINDSIGHT_BASE_URL="https://api.hindsight.vectorize.io"

# HINDSIGHT_BANK_ID: Persistent Memory Bank Identifier for RESQ Agent disaster records
HINDSIGHT_BANK_ID="resq-mem-disaster-response-v1"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

